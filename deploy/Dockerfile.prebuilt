# Serves an already-built Flutter web bundle with nginx.
#
# Used by the release workflow: the `web` job builds the bundle with the same
# Flutter version CI tests with, and this image only packages it. That avoids
# depending on a third-party Flutter image being published for every version.
#
# Build context: a folder that contains deploy/nginx.conf and web/ (the
# contents of the *-web.zip release asset).

FROM nginxinc/nginx-unprivileged:stable-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY web/ /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --spider http://127.0.0.1:8080/healthz || exit 1

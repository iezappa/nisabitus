<?xml version="1.0" encoding="utf-8"?>
<!-- API 30 and below. Redundant with android:allowBackup="false", and kept as
     defence in depth: if that attribute is ever flipped back by a template
     update, Auto Backup still finds nothing it is allowed to copy. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
